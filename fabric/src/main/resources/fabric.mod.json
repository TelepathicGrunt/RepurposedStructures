{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",

  "name": "${mod_display_name}",
  "description": "${mod_description}",
  "authors": [
    "TelepathicGrunt"
  ],
  "contact": {
    "homepage": "${homepage_url}",
    "sources": "${sources_url}",
    "issues": "${issues_url}"
  },

  "license": "GNU Lesser General Public License v3.0",
  "icon": "assets/repurposed_structures/repurposed_structures_logo.png",

  "environment": "*",
  "entrypoints": {
    "main": [
      "com.telepathicgrunt.repurposedstructures.RepurposedStructuresFabric"
    ],
    "modmenu": [
      "com.telepathicgrunt.repurposedstructures.configs.ModMenuCompat"
    ]
  },
  "mixins": [
    "repurposed_structures-fabric.mixins.json",
    "repurposed_structures-common.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": ">=${minecraft_version}",
    "java": ">=${java_version}",
    "fabric-api": "*",
    "midnightlib": ">=1.5.7"
  }
}
